{
	"name": "zaridium",
	"private": true,
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"compile": "rbxtsc --verbose --type=model",
		"watch": "rbxtsc -w",
		"lint": "eslint src/",
		"build": "rojo build default.project.json --output \"Zaridium.rbxm\"",
		"serve": "rojo serve place.project.json",
		"bundle": "npm run build && remodel run ci/bundle.lua public/dev.lua dev verbose",
		"bundle:dbg": "npm run build && remodel run ci/bundle.lua public/dev.lua dev_dbg debug verbose"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@rbxts/compiler-types": "^3.0.0-types.0",
		"@rbxts/types": "^1.0.960",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-roblox-ts": "^1.4.1",
		"luamin": "^1.0.4",
		"prettier": "^3.9.10",
		"roblox-ts": "^3.0.0",
		"typescript": "5.5.3",
		"typescript-eslint": "^8.72.1"
	},
	"overrides": {
		"minimatch": "^11.0.3"
	},
	"dependencies": {
		"@rbxts/make": "^1.0.6",
		"@rbxts/react": "^17.3.13-ts.1",
		"@rbxts/react-reflex": "^0.3.7",
		"@rbxts/react-roblox": "^17.3.13-ts.1",
		"@rbxts/reflex": "^4.3.1",
		"@rbxts/ripple": "^0.10.2",
		"@rbxts/services": "^1.6.0"
	}
}